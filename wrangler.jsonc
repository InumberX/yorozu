{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yorozu",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // Route every request through the Worker first so the Basic-auth gate in
    // workers/app.ts also covers static assets (JS/CSS/images/WASM). Without
    // this, matching files in build/client are served before the Worker runs.
    "run_worker_first": true,
    // SPA モード（ssr:false）。prerender 済みルートは各 HTML を返す。未列挙パスは ASSETS では
    // 404 にし、Worker（workers/handler.ts）が SPA フォールバックを 404 で返して、root の
    // ErrorBoundary に 404 を表示させる。"single-page-application" にすると未列挙パスへ
    // JA ホームが 200 で返り、/fr がホームとして表示されてしまう。
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "development": {
      "name": "dev-yorozu",
    },
    "production": {
      "name": "yorozu",
    },
  },
}
