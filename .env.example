# Build-time variables consumed by vite.config.ts via Vite's loadEnv.
# For local builds (`npm start`, `npm run deploy-*`), copy this file to
# `.env.development.local` or `.env.production.local` and fill in the values
# matching the target environment.
# CI builds inject these via GitHub Environment variables, so the .env files
# are only needed for local invocations of any script that bundles the worker.
#
# How empty values are handled is decided in scripts/build-env.ts:
# - SITE_URL is required whenever CLOUDFLARE_ENV is set (build-development,
#   build-production, CI deploys); the build fails without it. Plain
#   `npm run build` falls back to http://localhost:5173 because it is not deployed.
# - GOOGLE_ANALYTICS_ID has no default. Leave it empty and no gtag is emitted.

NO_INDEX=
SITE_URL=
SITE_NAME=
GOOGLE_ANALYTICS_ID=
